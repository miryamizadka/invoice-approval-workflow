LLM_PROVIDER=mock
# GROQ_API_KEY=your-key-here   # required only when LLM_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b   # optional override, defaults to this model

# N1 - JWT auth. Generate a real secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-real-generated-secret
# JWT_EXPIRY_HOURS=8   # optional override, defaults to 8

# M5/N1 - fetch JWT_SECRET through Dapr's Secrets API (same mechanism
# GROQ_API_KEY already uses) instead of reading the env var above directly.
# JWT_SECRET above still acts as the fallback if the store has no value or
# is unreachable. Set to true in docker-compose.yml for every service that
# issues/verifies a JWT; left unset (false) in tests/CI on purpose - see
# shared/jwt_secret_loader.py's module docstring for why.
# JWT_SECRET_DAPR_ENABLED=true

# N3 - Bulkhead (Decision->Groq, Intake->Approval) - all optional overrides,
# each has a code-level default (see ARCHITECTURE.md §12).
# LLM_BULKHEAD_MAX_CONCURRENCY=5
# LLM_BULKHEAD_TIMEOUT_SECONDS=15.0
# APPROVAL_STATUS_BULKHEAD_MAX_CONCURRENCY=20
# APPROVAL_STATUS_BULKHEAD_TIMEOUT_SECONDS=5.0

# N3 - Throttling (per-identity, complements the gateway's own per-IP
# rate limit) - all optional overrides, each has a code-level default.
# INVOICE_SUBMIT_RATE_LIMIT=20
# INVOICE_SUBMIT_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_REGISTER_RATE_LIMIT=5
# AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_LOGIN_RATE_LIMIT=20
# AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60